# Copie para .env e ajuste os valores: cp .env.example .env
# Formato aceito pelo dotenv e pelo Docker Compose:
#   - comentários começam com #
#   - sem espaços ao redor do "="

# Servidor
HOST=http://localhost
PORT=3000

# Servidor Conversor API (sem barra no final)
CONVERSOR_API_URL=http://localhost:5000

# Produção (só usados pelo docker-compose.prod.yml)
# domínio público apontando para o servidor (o Caddy emite o HTTPS para ele)
DOMINIO=exemplo.com
# workers do conversor Python (cada um + LibreOffice usa bastante RAM)
WORKERS_CONVERSOR=2

# Doações por Pix (só usados por `npm run gera:pix`, que gera o QR Code e o "copia e cola" da página de doação)
# o código gerado fica público no site e no repositório: use uma chave ALEATÓRIA, não CPF, e-mail ou telefone
PIX_CHAVE=sua-chave-aleatoria
# nome de quem recebe (até 25 caracteres) e cidade (até 15), como aparecem no app do banco
PIX_NOME=Seu Nome
PIX_CIDADE=Sua Cidade
# opcional: mensagem mostrada no app do banco
# PIX_DESCRICAO=goodbyePDF
