# Copie para .env e ajuste os valores: cp .env.example .env
# Formato aceito pelo dotenv e pelo Docker Compose:
#   - comentários começam com #
#   - sem espaços ao redor do "="

# Servidor
HOST=http://localhost
PORT=3000

# Servidor Conversor API (sem barra no final)
CONVERSOR_API_URL=http://localhost:5000

# Produção (só usados pelo docker-compose.prod.yml)
# domínio público apontando para o servidor (o Caddy emite o HTTPS para ele)
DOMINIO=exemplo.com
# workers do conversor Python (cada um + LibreOffice usa bastante RAM)
WORKERS_CONVERSOR=2
